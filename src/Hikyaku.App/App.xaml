<Application x:Class="Hikyaku.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.xaml"/>
        <ResourceDictionary Source="Theme/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <!-- Drop-downs, menus and tooltips appear at once and sharp. WPF's slide / fade draws their text without ClearType
           until the animation ends, which looked fuzzy and then "cleared" (live finding in the Inbox filters). -->
      <x:Static x:Key="{x:Static SystemParameters.ComboBoxPopupAnimationKey}" Member="prim:PopupAnimation.None"/>
      <x:Static x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}" Member="prim:PopupAnimation.None"/>
      <x:Static x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}" Member="prim:PopupAnimation.None"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
