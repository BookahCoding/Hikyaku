<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Authentic Herald Ukiyo-e tokens (BookahHermes AccentPalette / ThemeColors / HermesTheme
    @ 5f00986b2a582e480592fd680131d501d57038ef). MIT — see docs/THIRD-PARTY-HERALD-LICENSE.txt
    and docs/THEME-REFERENCE.md. Layout remains ChatGPT-familiar (sidebar / conversation / composer).
  -->

  <!-- Dark Ukiyo-e (default) -->
  <Color x:Key="Color.Bg">#FF0E1424</Color>
  <Color x:Key="Color.Surface">#FF151C30</Color>
  <Color x:Key="Color.SurfaceSidebar">#FF111829</Color>
  <Color x:Key="Color.SurfaceRaised">#FF1B2440</Color>
  <Color x:Key="Color.Surface3">#FF232D4D</Color>
  <Color x:Key="Color.Well">#FF111829</Color>
  <Color x:Key="Color.Text">#FFF4EDD9</Color>
  <Color x:Key="Color.Text2">#FFDCD3BC</Color>
  <Color x:Key="Color.TextMuted">#FFA8A08C</Color>
  <Color x:Key="Color.Text5">#FF7F7B6C</Color>
  <Color x:Key="Color.Accent">#FFE5927E</Color>
  <Color x:Key="Color.OnAccent">#FF0A0A0C</Color>
  <Color x:Key="Color.Border">#33F4EDD9</Color>
  <Color x:Key="Color.Danger">#FFF4739B</Color>
  <Color x:Key="Color.Success">#FF7DBE8A</Color>
  <Color x:Key="Color.Warning">#FFE3B458</Color>
  <Color x:Key="Color.MarkVermilion">#FFA63F2D</Color>
  <Color x:Key="Color.MarkPaper">#FFF4EDD9</Color>

  <!-- Light Ukiyo-e (swapped via ThemeService into the same brush keys) -->
  <Color x:Key="Color.Light.Bg">#FFF4EDD9</Color>
  <Color x:Key="Color.Light.Surface">#FFFAF5E3</Color>
  <Color x:Key="Color.Light.SurfaceSidebar">#FFF0E8D3</Color>
  <Color x:Key="Color.Light.SurfaceRaised">#FFEFE6CF</Color>
  <Color x:Key="Color.Light.Surface3">#FFE6DCC2</Color>
  <Color x:Key="Color.Light.Well">#FFF0E8D3</Color>
  <Color x:Key="Color.Light.Text">#FF2B2822</Color>
  <Color x:Key="Color.Light.Text2">#FF403B31</Color>
  <Color x:Key="Color.Light.TextMuted">#FF6A5F50</Color>
  <Color x:Key="Color.Light.Text5">#FF8C8170</Color>
  <Color x:Key="Color.Light.Accent">#FFA63F2D</Color>
  <Color x:Key="Color.Light.OnAccent">#FFFFFFFF</Color>
  <Color x:Key="Color.Light.Border">#140A0A1E</Color>
  <Color x:Key="Color.Light.Danger">#FF8A1C45</Color>
  <Color x:Key="Color.Light.Success">#FF3F6A4B</Color>
  <Color x:Key="Color.Light.Warning">#FF855608</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.SurfaceSidebar" Color="{StaticResource Color.SurfaceSidebar}"/>
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}"/>
  <SolidColorBrush x:Key="Brush.Well" Color="{StaticResource Color.Well}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.MarkVermilion" Color="{StaticResource Color.MarkVermilion}"/>
  <SolidColorBrush x:Key="Brush.MarkPaper" Color="{StaticResource Color.MarkPaper}"/>

  <!-- Text: Inter (SIL OFL; the nearest open match to Apple's system text face — San Francisco is not licensed for other platforms), then Geist, then Windows' own UI font. Code: Geist Mono (MIT). Local files only — no CDN. -->
  <FontFamily x:Key="Font.Body">pack://application:,,,/Assets/Fonts/#Inter, pack://application:,,,/Assets/Fonts/#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
  <!-- Windows' own icon fonts (Windows 11, then Windows 10): nothing bundled, nothing to license. -->
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Code">pack://application:,,,/Assets/Fonts/#Geist Mono</FontFamily>
  <CornerRadius x:Key="Radius.Control">10</CornerRadius>
  <CornerRadius x:Key="Radius.Large">14</CornerRadius>
  <sys:Double x:Key="Size.Body">15</sys:Double>
  <sys:Double x:Key="Size.BodySmall">13.5</sys:Double>
  <sys:Double x:Key="Size.Caption">12</sys:Double>
  <sys:Double x:Key="Size.Heading">16</sys:Double>
  <sys:Double x:Key="Size.Title">22</sys:Double>
  <Duration x:Key="Duration.Theme">0:0:0.180</Duration>
  <Duration x:Key="Duration.Panel">0:0:0.180</Duration>
</ResourceDictionary>
