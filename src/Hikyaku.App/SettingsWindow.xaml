<Window x:Class="Hikyaku.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="900" Height="660" MinWidth="720" MinHeight="480" Background="{DynamicResource Brush.Surface}"
        WindowStartupLocation="CenterOwner">
  <!-- 0.5.2: laid out like Claude Desktop's settings (the maintainer's request): sections on the left, one page each, plain words.
       Every named control is the same as before, so the code behind and the acceptance checks did not change meaning. -->
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="{StaticResource Size.Title}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="{StaticResource Size.Heading}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="FontSize" Value="{StaticResource Size.BodySmall}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Sections -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Brush.SurfaceSidebar}" Padding="10,16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="{StaticResource Size.Heading}" FontWeight="SemiBold" Margin="10,0,0,12"/>
        <ListBox x:Name="SectionNav" SelectionChanged="SectionNav_SelectionChanged" ItemContainerStyle="{StaticResource ConversationItem}"
                 AutomationProperties.Name="Settings sections">
          <ListBoxItem x:Name="NavGeneral" Tag="general" AutomationProperties.Name="General">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/><TextBlock Text="General" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavAppearance" Tag="appearance" AutomationProperties.Name="Appearance">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;"/><TextBlock Text="Appearance" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavAccount" Tag="account" AutomationProperties.Name="Account">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE77B;"/><TextBlock Text="Account" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavProfiles" Tag="profiles" AutomationProperties.Name="Profiles">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE716;"/><TextBlock Text="Profiles" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavSafety" Tag="safety" AutomationProperties.Name="Safety">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xEA18;"/><TextBlock Text="Safety" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavConnection" Tag="connection" AutomationProperties.Name="Connection">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE774;"/><TextBlock Text="Connection" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="NavUpdates" Tag="updates" AutomationProperties.Name="Updates">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE895;"/><TextBlock Text="Updates" VerticalAlignment="Center"/></StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuietScrollViewer}">
      <Grid Margin="32,24,32,24" MaxWidth="720" HorizontalAlignment="Left">

        <!-- General -->
        <StackPanel x:Name="PageGeneral">
          <TextBlock Style="{StaticResource PageTitle}" Text="General"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="How Hikyaku looks and behaves on this PC."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource GroupTitle}" Text="View" AutomationProperties.Name="View mode"/>
              <RadioButton x:Name="ModeSimple" GroupName="Mode" Checked="Mode_Changed" Margin="0,4,0,0"
                           Content="Simple: for everyday chatting" AutomationProperties.Name="Simple view"/>
              <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,8"
                         Text="Chats, the Inbox and the questions Hermes needs you to answer. Technical tools are tucked away."/>
              <RadioButton x:Name="ModeAdvanced" GroupName="Mode" Checked="Mode_Changed"
                           Content="Advanced: manage Hermes" AutomationProperties.Name="Advanced view"/>
              <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,8"
                         Text="Adds skills, tools, settings, scheduled jobs, rooms, projects and more."/>
              <TextBlock Style="{StaticResource Hint}"
                         Text="This only changes what is shown, never what Hermes may do. You can switch back at any time."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource GroupTitle}" Text="Text size" AutomationProperties.Name="Text size"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="TextNormal" GroupName="TextSize" Content="Normal" Margin="0,0,16,0" AutomationProperties.Name="Normal text size"/>
                <RadioButton x:Name="TextLarger" GroupName="TextSize" Content="Larger" Margin="0,0,16,0" AutomationProperties.Name="Larger text size"/>
                <RadioButton x:Name="TextLargest" GroupName="TextSize" Content="Largest" AutomationProperties.Name="Largest text size"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Makes everything in the window bigger, once you press Save."/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="NotificationsSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Notifications"/>
                <CheckBox x:Name="NotificationsEnabled" Content="Show Windows notifications" Margin="0,4,0,0"
                          AutomationProperties.Name="Enable notifications"/>
                <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                           Text="For new Inbox results and when Hermes needs you, only for the profiles this PC shows. They never include the message itself. Windows may still hold them back (Focus, Do not disturb)."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Appearance" AutomationProperties.Name="Appearance"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="Colour themes inspired by the prints of Katsushika Hokusai. Changes show at once; press Save to keep them."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource GroupTitle}" Text="Theme"/>
              <ListBox x:Name="ThemePicker" SelectionChanged="AppearancePreview_Changed" AutomationProperties.Name="Theme picker"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-4,4,0,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Frame" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="132">
                      <Grid Height="58">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="{Binding LightBackground}" CornerRadius="8,0,0,8">
                          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border Background="{Binding LightText}" Height="4" Width="30" CornerRadius="2" HorizontalAlignment="Left"/>
                            <Border Background="{Binding LightAccent}" Height="10" Width="18" CornerRadius="5" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{Binding DarkBackground}" CornerRadius="0,8,8,0">
                          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border Background="{Binding DarkText}" Height="4" Width="30" CornerRadius="2" HorizontalAlignment="Left"/>
                            <Border Background="{Binding DarkAccent}" Height="10" Width="18" CornerRadius="5" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Name}" Margin="2,6,0,2" FontSize="{StaticResource Size.BodySmall}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource GroupTitle}" Text="Light or dark"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="AppearLight" Content="Light" GroupName="Appear" Checked="AppearancePreview_Changed" Margin="0,0,16,0"/>
                <RadioButton x:Name="AppearDark" Content="Dark" GroupName="Appear" Checked="AppearancePreview_Changed" Margin="0,0,16,0"/>
                <RadioButton x:Name="AppearSystem" Content="Same as Windows" GroupName="Appear" Checked="AppearancePreview_Changed"/>
              </StackPanel>
              <Border x:Name="ThemePreview" Margin="0,12,0,0" Height="44" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      AutomationProperties.Name="Appearance preview">
                <TextBlock x:Name="ThemePreviewLabel" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="MotionHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Account -->
        <StackPanel x:Name="PageAccount" Visibility="Collapsed">
          <TextBlock x:Name="AccountHeading" Style="{StaticResource PageTitle}" Text="Account"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="The Hermes gateway this PC talks to, and your sign-in."/>
          <StackPanel x:Name="ConnectionSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Gateway"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" Margin="0,4,0,4"/>
                <TextBox x:Name="GatewayId" AutomationProperties.Name="Gateway name"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Any label you like; it is only shown on this PC."/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Address"/>
                <TextBox x:Name="GatewayUrl" AutomationProperties.Name="Gateway URL"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Your Hermes dashboard's web address, for example https://hermes.example.com"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource GroupTitle}" Text="Sign in"/>
              <StackPanel x:Name="CredentialsSection">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Username" Margin="0,4,0,4"/>
                <TextBox x:Name="Username" AutomationProperties.Name="Username"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                <PasswordBox x:Name="Password" AutomationProperties.Name="Password" Padding="8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Stored encrypted for your Windows account. Leave it empty to keep the saved one."/>
              </StackPanel>
              <StackPanel x:Name="ConnectionHintSection">
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Hikyaku signs in to your dashboard the way your browser does. Nothing is sent anywhere else."/>
              </StackPanel>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="SignInDiscover" Content="Sign in and discover profiles" Click="SignInDiscover_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                <Button x:Name="SignInBrowser" Content="Sign in with browser" Click="SignInBrowser_Click" Margin="0,0,8,6"
                        AutomationProperties.HelpText="Opens your default browser at this gateway's sign-in page. Available only when the gateway offers browser sign-in."/>
                <Button x:Name="SignOutBrowser" Content="Sign out" Click="SignOut_Click" Margin="0,0,8,6"/>
              </WrapPanel>
              <TextBlock x:Name="AuthStatus" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Profiles -->
        <StackPanel x:Name="PageProfiles" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Profiles"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="Which of the gateway's agents this PC shows."/>
          <StackPanel x:Name="ProfilesSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Shown on this PC"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Only ticked profiles appear in Hikyaku: chats, the Inbox, notifications and search. New profiles are never ticked by themselves. This is a display choice on this PC, not a permission."/>
                <StackPanel x:Name="ProfileList" Margin="0,10,0,0"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Add a profile by its name"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="NewProfile" AutomationProperties.Name="Profile id to add"/>
                  <Button Grid.Column="1" Content="Add" Click="AddProfile_Click" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Safety -->
        <StackPanel x:Name="PageSafety" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Safety"/>
          <TextBlock Style="{StaticResource PageIntro}"
                     Text="When Hermes must ask you before running a command that could do damage. This is set on the gateway for the whole profile, so it applies to every app that uses it. YOLO in a chat switches the questions off for that chat only."/>
          <StackPanel x:Name="ApprovalsSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Dangerous command approvals"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Profile" Margin="0,4,0,4"/>
                <ComboBox x:Name="ApprovalProfile" SelectionChanged="ApprovalProfile_Changed" AutomationProperties.Name="Approval profile" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"/>
                <StackPanel x:Name="ApprovalModes" Margin="0,10,0,0"/>
                <TextBlock x:Name="ApprovalStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" AutomationProperties.Name="Approval status"/>
                <Button x:Name="ReloadApprovals" Content="Reload" Click="ReloadApprovals_Click" Margin="0,10,0,0" HorizontalAlignment="Left"
                        ToolTip="Read the setting from the gateway again"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Connection -->
        <StackPanel x:Name="PageConnection" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Connection"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="Extra settings for gateways behind a protected network."/>
          <StackPanel x:Name="AccessSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Cloudflare Access (optional)"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Only needed when the gateway sits behind Cloudflare Access. Paste a service token's Client ID and Secret. It is sent only over https, only to this gateway's address. The secret is stored encrypted for your Windows account."/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID"/>
                <TextBox x:Name="AccessClientId" AutomationProperties.Name="Cloudflare Access client ID"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Client Secret (never shown again)"/>
                <PasswordBox x:Name="AccessClientSecret" AutomationProperties.Name="Cloudflare Access client secret" Padding="8"/>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="AccessSave" Content="Save token" Click="AccessSave_Click" Margin="0,0,8,6"/>
                  <Button x:Name="AccessRemove" Content="Remove token" Click="AccessRemove_Click" Margin="0,0,8,6"/>
                  <Button x:Name="AccessTest" Content="Test connection" Click="AccessTest_Click" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock x:Name="AccessStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.Name="Cloudflare Access status"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Updates -->
        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Updates"/>
          <TextBlock Style="{StaticResource PageIntro}" Text="New versions come from Hikyaku's page on GitHub and are installed only after you confirm."/>
          <StackPanel x:Name="UpdatesSection">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="UpdateCurrent" Style="{StaticResource GroupTitle}"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="UpdateCheck" Content="Check for updates" Click="UpdateCheck_Click" Margin="0,0,8,6"/>
                  <Button x:Name="UpdateDownload" Content="Download and verify" IsEnabled="False" Click="UpdateDownload_Click" Margin="0,0,8,6"/>
                  <Button x:Name="UpdateInstall" Content="Install and restart" IsEnabled="False" Click="UpdateInstall_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                  <Button x:Name="UpdatePage" Content="Open release page" IsEnabled="False" Click="UpdatePage_Click" Margin="0,0,8,6"/>
                </WrapPanel>
                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,8,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.Name="Update status"/>
                <TextBox x:Name="UpdateNotes" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="Release notes"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox x:Name="UpdateOnStart" Content="Check for a new version when Hikyaku starts"
                          AutomationProperties.Name="Check for a new version when Hikyaku starts"/>
                <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                           Text="It only asks GitHub which version is newest and shows a button if there is one; nothing is downloaded until you click."/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="A download is installed only after its signature matches the key built into this app, and only after you confirm a second time. Your settings and sign-in are kept."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Save / Cancel: always in reach -->
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="32,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90"/>
        <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="90"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
