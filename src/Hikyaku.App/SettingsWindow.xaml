<Window x:Class="Hikyaku.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="720" Background="{DynamicResource Brush.Surface}"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock x:Name="AccountHeading" Text="Account" FontSize="18" Visibility="Collapsed"/>
      <StackPanel x:Name="ConnectionSection">
      <TextBlock Text="Hermes dashboard (remote gateway)" FontSize="18"/>
      <TextBlock Margin="0,10,0,2" Text="Gateway name (local label)"/>
      <TextBox x:Name="GatewayId" AutomationProperties.Name="Gateway name"/>
      <TextBlock Margin="0,10,0,2" Text="Dashboard URL (e.g. http://host:9119)"/>
      <TextBox x:Name="GatewayUrl" AutomationProperties.Name="Gateway URL"/>
      </StackPanel>
      <StackPanel x:Name="CredentialsSection">
      <TextBlock Margin="0,10,0,2" Text="Username"/>
      <TextBox x:Name="Username" AutomationProperties.Name="Username"/>
      <TextBlock Margin="0,10,0,2" Text="Password (Windows DPAPI; leave blank to keep current)"/>
      <PasswordBox x:Name="Password" AutomationProperties.Name="Password" Padding="8"/>
      </StackPanel>
      <StackPanel x:Name="ConnectionHintSection">
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="Uses dashboard password-login + WebSocket ticket (not OpenAI bearer). Live authenticated chat is pending a user-entered credential test — no credentials are read from disk by the build."/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="SignInDiscover" Content="Sign in and discover profiles" Click="SignInDiscover_Click"/>
        <Button x:Name="SignInBrowser" Margin="8,0,0,0" Content="Sign in with browser" Click="SignInBrowser_Click"
                AutomationProperties.HelpText="Opens your default browser at this gateway's sign-in page. Available only when the gateway advertises browser sign-in."/>
        <Button x:Name="SignOutBrowser" Margin="8,0,0,0" Content="Sign out" Click="SignOut_Click"/>
      </StackPanel>
      <TextBlock x:Name="AuthStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>

      <StackPanel x:Name="AccessSection">
      <TextBlock Margin="0,24,0,4" Text="Cloudflare Access (optional)" FontSize="18"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="Only needed when the gateway sits behind Cloudflare Access. Paste a service token's Client ID and Secret. It is sent only over https, only to this gateway's address, and never anywhere else. The secret is stored encrypted for your Windows user."/>
      <TextBlock Margin="0,10,0,2" Text="Client ID"/>
      <TextBox x:Name="AccessClientId" AutomationProperties.Name="Cloudflare Access client ID"/>
      <TextBlock Margin="0,10,0,2" Text="Client Secret (never shown again)"/>
      <PasswordBox x:Name="AccessClientSecret" AutomationProperties.Name="Cloudflare Access client secret" Padding="8"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="AccessSave" Content="Save token" Click="AccessSave_Click"/>
        <Button x:Name="AccessRemove" Content="Remove token" Margin="8,0,0,0" Click="AccessRemove_Click"/>
        <Button x:Name="AccessTest" Content="Test connection" Margin="8,0,0,0" Click="AccessTest_Click"/>
      </StackPanel>
      <TextBlock x:Name="AccessStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                 AutomationProperties.Name="Cloudflare Access status"/>

      </StackPanel>

      <StackPanel x:Name="UpdatesSection">
      <TextBlock Margin="0,24,0,4" Text="Updates" FontSize="18"/>
      <TextBlock x:Name="UpdateCurrent" Foreground="{DynamicResource Brush.TextMuted}"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="UpdateCheck" Content="Check for updates" Click="UpdateCheck_Click"/>
        <Button x:Name="UpdateDownload" Margin="8,0,0,0" Content="Download and verify" IsEnabled="False" Click="UpdateDownload_Click"/>
        <Button x:Name="UpdateInstall" Margin="8,0,0,0" Content="Install and restart" IsEnabled="False" Click="UpdateInstall_Click"/>
        <Button x:Name="UpdatePage" Margin="8,0,0,0" Content="Open release page" IsEnabled="False" Click="UpdatePage_Click"/>
      </StackPanel>
      <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,8,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
      <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                 AutomationProperties.Name="Update status"/>
      <TextBox x:Name="UpdateNotes" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
               VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="Release notes"/>
      <CheckBox x:Name="UpdateOnStart" Margin="0,8,0,0" Content="Check for a new version when Hikyaku starts"
                AutomationProperties.Name="Check for a new version when Hikyaku starts"/>
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="The start-up check only asks GitHub which version is newest and shows a button if there is one; nothing is downloaded until you click. A downloaded package is installed only after its signature verifies against the publisher key built into this app, and only after you confirm a second time. Settings and sign-in are kept."/>

      </StackPanel>

      <StackPanel x:Name="ProfilesSection">
      <TextBlock Margin="0,24,0,4" Text="Profiles shown on this installation" FontSize="18"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="Only ticked profiles appear in navigation, conversations, search, badges, toasts, sounds and deep links. This is a local display preference, not access control. New profiles are never ticked automatically. Empty selection shows onboarding."/>
      <StackPanel x:Name="ProfileList" Margin="0,8,0,0"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="NewProfile" AutomationProperties.Name="Profile id to add"/>
        <Button Grid.Column="1" Content="Add profile" Click="AddProfile_Click" Margin="6,0,0,0"/>
      </Grid>

      </StackPanel>

      <TextBlock Margin="0,24,0,4" Text="Appearance" FontSize="18" AutomationProperties.Name="Appearance"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="Hokusai-inspired palettes (approximate tokens, not measured artworks). Light / Dark / System; reduced-motion and high-contrast follow Windows."/>
      <TextBlock Margin="0,8,0,2" Text="Theme"/>
      <ComboBox x:Name="ThemePicker" SelectionChanged="AppearancePreview_Changed" AutomationProperties.Name="Theme picker"/>
      <TextBlock Margin="0,8,0,2" Text="Light / dark"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="AppearLight" Content="Light" GroupName="Appear" Checked="AppearancePreview_Changed" Margin="0,0,12,0"/>
        <RadioButton x:Name="AppearDark" Content="Dark" GroupName="Appear" Checked="AppearancePreview_Changed" Margin="0,0,12,0"/>
        <RadioButton x:Name="AppearSystem" Content="System" GroupName="Appear" Checked="AppearancePreview_Changed"/>
      </StackPanel>
      <Border x:Name="ThemePreview" Margin="0,10,0,0" Height="48" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              AutomationProperties.Name="Appearance preview">
        <TextBlock x:Name="ThemePreviewLabel" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="MotionHint" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" TextWrapping="Wrap"/>

      <StackPanel x:Name="ApprovalsSection">
      <TextBlock Margin="0,24,0,4" Text="Dangerous command approvals" FontSize="18"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                 Text="Profile-wide Hermes setting (affects other clients on the same profile). Manual / Smart / Off from the gateway schema. Separate from this-chat YOLO in the composer."/>
      <ComboBox x:Name="ApprovalProfile" Margin="0,8,0,4" SelectionChanged="ApprovalProfile_Changed"
                AutomationProperties.Name="Approval profile"/>
      <StackPanel x:Name="ApprovalModes" Margin="0,4,0,0"/>
      <TextBlock x:Name="ApprovalStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                 AutomationProperties.Name="Approval status"/>
      <Button x:Name="ReloadApprovals" Content="Reload from gateway" Click="ReloadApprovals_Click" Margin="0,8,0,0"
              HorizontalAlignment="Left"/>

      </StackPanel>

      <TextBlock Margin="0,24,0,4" Text="View" FontSize="18" AutomationProperties.Name="View mode"/>
      <RadioButton x:Name="ModeSimple" GroupName="Mode" Checked="Mode_Changed" Margin="0,4,0,0"
                   Content="Simple: for everyday chatting" AutomationProperties.Name="Simple view"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="24,0,0,6"
                 Text="Chats, the Inbox and the questions Hermes needs you to answer. Technical tools are tucked away."/>
      <RadioButton x:Name="ModeAdvanced" GroupName="Mode" Checked="Mode_Changed"
                   Content="Advanced: manage Hermes" AutomationProperties.Name="Advanced view"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="24,0,0,0"
                 Text="Skills, tools, MCP servers, configuration, scheduled jobs, rooms, projects and more."/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                 Text="This changes what is shown, never what is allowed: approvals, shared folders and terminal permissions are the same in both views. Anything already in effect (a shared folder, YOLO on) is always shown. It is not a lock: you can switch here at any time. Ctrl+K opens the command palette."/>

      <TextBlock Margin="0,24,0,4" Text="Text size" FontSize="18" AutomationProperties.Name="Text size"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TextNormal" GroupName="TextSize" Content="Normal" Margin="0,0,16,0" AutomationProperties.Name="Normal text size"/>
        <RadioButton x:Name="TextLarger" GroupName="TextSize" Content="Larger" Margin="0,0,16,0" AutomationProperties.Name="Larger text size"/>
        <RadioButton x:Name="TextLargest" GroupName="TextSize" Content="Largest" AutomationProperties.Name="Largest text size"/>
      </StackPanel>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Makes everything in the window bigger. It applies when you press Save."/>

      <StackPanel x:Name="NotificationsSection">
      <TextBlock Margin="0,24,0,4" Text="Notifications" FontSize="18"/>
      <CheckBox x:Name="NotificationsEnabled" Content="Show Windows toasts for allowed profiles"
                ToolTip="Off disables OS toast delivery. Gate still denies cold/deselected/unknown profiles."
                AutomationProperties.Name="Enable notifications"/>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Toasts never fire for unselected profiles and never contain message text. Turning this on registers a notification name for your Windows user (one per-user registry entry, no administrator rights); turning it off removes it. Windows can still hold toasts back (Focus assist, notification settings)."/>

      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"/>
        <Button Content="Cancel" Click="Cancel_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
