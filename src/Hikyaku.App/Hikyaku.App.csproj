<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hikyaku</AssemblyName>
    <RootNamespace>Hikyaku.App</RootNamespace>
    <ApplicationIcon>Assets\Hikyaku.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hikyaku.Core\Hikyaku.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Hikyaku.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hikyaku.App.Tests" />
  </ItemGroup>
</Project>
